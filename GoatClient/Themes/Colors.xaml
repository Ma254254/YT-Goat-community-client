<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- GOAT CLIENT palette -->
    <Color x:Key="BackgroundColor">#080A10</Color>
    <Color x:Key="CardColor">#101522</Color>
    <Color x:Key="SecondaryColor">#182137</Color>
    <Color x:Key="TextColor">#F4F7FF</Color>
    <Color x:Key="MutedColor">#8994AA</Color>
    <Color x:Key="AccentColor">#00D9FF</Color>
    <Color x:Key="Accent2Color">#7A5CFF</Color>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#0B0E17" />
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}" />
    <SolidColorBrush x:Key="InputBrush" Color="#0C111C" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="Accent2Brush" Color="{StaticResource Accent2Color}" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#1A2338" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#26324D" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1A00D9FF" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#3DDC97" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FFC857" />
    <SolidColorBrush x:Key="DangerBrush" Color="#FF5C7A" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#26FF5C7A" />
    <SolidColorBrush x:Key="OverlayBrush" Color="#C8050710" />

    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource AccentColor}" Offset="0" />
        <GradientStop Color="{StaticResource Accent2Color}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AccentGradientVerticalBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource AccentColor}" Offset="0" />
        <GradientStop Color="{StaticResource Accent2Color}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ActiveNavBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#2600D9FF" Offset="0" />
        <GradientStop Color="#0A7A5CFF" Offset="1" />
    </LinearGradientBrush>

    <!-- Subtle hero glow, deliberately low opacity -->
    <RadialGradientBrush x:Key="HeroGlowBrush" Center="0.85,0.3" GradientOrigin="0.85,0.3" RadiusX="0.6" RadiusY="0.9">
        <GradientStop Color="#2200D9FF" Offset="0" />
        <GradientStop Color="#107A5CFF" Offset="0.5" />
        <GradientStop Color="#00101522" Offset="1" />
    </RadialGradientBrush>
</ResourceDictionary>
