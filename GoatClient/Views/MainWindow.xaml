<Window x:Class="GoatClient.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:GoatClient.Controls"
        xmlns:vm="clr-namespace:GoatClient.ViewModels"
        xmlns:models="clr-namespace:GoatClient.Models"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="GOAT CLIENT"
        Icon="pack://application:,,,/GoatClient;component/Assets/Logo/GoatClient.ico"
        Width="1400" Height="800" MinWidth="1200" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="CanResize"
        FontFamily="Segoe UI Variable Display, Segoe UI" Foreground="{StaticResource TextBrush}"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="8" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding Dialogs.Current.CancelCommand}" />
    </Window.InputBindings>

    <!-- Near-transparent background keeps the resize margin hit-testable -->
    <Grid x:Name="RootGrid" Margin="12" Background="#01000000">
        <Border x:Name="ShadowBorder" CornerRadius="14" Background="{StaticResource BackgroundBrush}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.55" Color="#000000" />
            </Border.Effect>
        </Border>

        <Border x:Name="RootBorder" CornerRadius="14" Background="{StaticResource BackgroundBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ================= SIDEBAR ================= -->
                <Border x:Name="SidebarBorder" CornerRadius="13,0,0,13" Background="{StaticResource SidebarBrush}"
                        BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,1,0"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <DockPanel Margin="18,22,18,18">
                        <Image DockPanel.Dock="Top" Source="{StaticResource LogoImage}" Height="104" Margin="0,0,0,18"
                               RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" />

                        <TextBlock DockPanel.Dock="Bottom" Text="{Binding VersionText}" Style="{StaticResource SectionLabel}"
                                   FontWeight="Normal" HorizontalAlignment="Center" Margin="0,10,0,0" Opacity="0.7" />

                        <controls:AccountCard DockPanel.Dock="Bottom" StatusText="{Binding AccountStatusText}" SubText="{Binding AccountSubText}"
                                              IsConnected="{Binding IsAccountConnected}" Face="{Binding AccountFace}" Hat="{Binding AccountHat}"
                                              ButtonText="{Binding AccountButtonText}"
                                              LoginCommand="{Binding LoginCommand}" OpenCommand="{Binding NavigateAccountCommand}" />

                        <Border DockPanel.Dock="Bottom" Style="{StaticResource Divider}" />

                        <!-- Community: opens the official invite in the default browser -->
                        <Button DockPanel.Dock="Bottom" Style="{StaticResource CommunityButton}" Command="{Binding OpenDiscordCommand}"
                                ToolTip="{Binding DiscordInvite}">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconChat}" Fill="#C9CEFF" Width="16" Height="16" Stretch="Uniform" />
                                <TextBlock Text="Discord" Margin="10,0,0,0" VerticalAlignment="Center" />
                                <Path Data="{StaticResource IconExternal}" Fill="{StaticResource MutedBrush}" Width="10" Height="10" Stretch="Uniform" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>

                        <Border DockPanel.Dock="Bottom" Style="{StaticResource Divider}" />

                        <StackPanel>
                            <TextBlock Text="MENU" Style="{StaticResource SectionLabel}" Margin="10,0,0,8" />
                            <controls:SidebarButton Content="HOME" Icon="{StaticResource IconHome}" Command="{Binding NavigateHomeCommand}"
                                                    IsActive="{Binding CurrentPage, Converter={StaticResource EqualsConverter}, ConverterParameter=Home}" />
                            <controls:SidebarButton Content="PLAY" Icon="{StaticResource IconPlay}" Command="{Binding NavigatePlayCommand}"
                                                    IsActive="{Binding CurrentPage, Converter={StaticResource EqualsConverter}, ConverterParameter=Play}" />
                            <controls:SidebarButton Content="PROFILES" Icon="{StaticResource IconProfiles}" Command="{Binding NavigateProfilesCommand}"
                                                    IsActive="{Binding CurrentPage, Converter={StaticResource EqualsConverter}, ConverterParameter=Profiles}" />
                            <controls:SidebarButton Content="SKINS" Icon="{StaticResource IconSkins}" Command="{Binding NavigateSkinsCommand}"
                                                    IsActive="{Binding CurrentPage, Converter={StaticResource EqualsConverter}, ConverterParameter=Skins}" />
                            <controls:SidebarButton Content="SETTINGS" Icon="{StaticResource IconSettings}" Command="{Binding NavigateSettingsCommand}"
                                                    IsActive="{Binding CurrentPage, Converter={StaticResource EqualsConverter}, ConverterParameter=Settings}" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- ================= MAIN AREA ================= -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Custom title bar -->
                    <Grid Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                            <Image Source="{StaticResource LogoImage}" Height="22" RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock Text="{Binding ProductName}" FontSize="12" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center" />
                            <Border Margin="16,0,0,0" CornerRadius="10" Padding="10,3" Background="{StaticResource CardBrush}"
                                    BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="StatusDot" Width="7" Height="7" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status.IsBusy}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status.Status}" Value="{x:Static models:LauncherStatus.Error}">
                                                        <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding Status.Message}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="7,0,0,0"
                                               MaxWidth="420" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,7,8,0">
                            <Button Style="{StaticResource WindowButton}" Click="Minimize_Click" ToolTip="Minimize">
                                <Path Data="{StaticResource IconWinMinimize}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="10" Height="10" Stretch="Uniform" />
                            </Button>
                            <Button Style="{StaticResource WindowButton}" Click="MaximizeRestore_Click" ToolTip="Maximize / Restore">
                                <Path x:Name="MaxRestoreIcon" Data="{StaticResource IconWinMaximize}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="10" Height="10" Stretch="Uniform" />
                            </Button>
                            <Button Style="{StaticResource CloseWindowButton}" Click="Close_Click" ToolTip="Close">
                                <Path Data="{StaticResource IconWinClose}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Width="10" Height="10" Stretch="Uniform" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Page host -->
                    <ContentControl x:Name="PageHost" Grid.Row="1" Margin="32,6,32,26" Focusable="False"
                                    Content="{Binding CurrentViewModel}">
                        <ContentControl.RenderTransform>
                            <TranslateTransform />
                        </ContentControl.RenderTransform>
                    </ContentControl>

                    <!-- Startup loading state -->
                    <Grid Grid.Row="1" Visibility="{Binding IsInitializing, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="260">
                            <Image Source="{StaticResource LogoImage}" Height="150" RenderOptions.BitmapScalingMode="HighQuality" />
                            <ProgressBar IsIndeterminate="{Binding IsInitializing}" Margin="30,26,30,0" />
                            <TextBlock Text="{Binding Status.Message}" Style="{StaticResource MutedText}" HorizontalAlignment="Center" Margin="0,12,0,0" />
                        </StackPanel>
                    </Grid>

                    <!-- Toast notifications -->
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding Notifications.Items}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                  Margin="0,0,24,24" Width="340" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:NotificationItem}">
                                <Button Margin="0,8,0,0" Cursor="Hand" FocusVisualStyle="{x:Null}" ToolTip="Dismiss"
                                        Command="{Binding DataContext.DismissNotificationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="12" Padding="0">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.45" />
                                                </Border.Effect>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="4" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border x:Name="Stripe" CornerRadius="12,0,0,12" Background="{StaticResource AccentBrush}" />
                                                    <ContentPresenter Grid.Column="1" Margin="14,12" />
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Kind}" Value="Success">
                                                    <Setter TargetName="Stripe" Property="Background" Value="{StaticResource SuccessBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="Warning">
                                                    <Setter TargetName="Stripe" Property="Background" Value="{StaticResource WarningBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Kind}" Value="Error">
                                                    <Setter TargetName="Stripe" Property="Background" Value="{StaticResource DangerBrush}" />
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextBrush}" />
                                        <TextBlock Text="{Binding Message}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <!-- ================= DIALOG OVERLAY ================= -->
                <Grid Grid.ColumnSpan="2" Background="{StaticResource OverlayBrush}"
                      Visibility="{Binding Dialogs.Current, Converter={StaticResource NullToVisibility}}">
                    <Border Style="{StaticResource ModernCard}" Width="480" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center"
                            DataContext="{Binding Dialogs.Current}" BorderBrush="{StaticResource BorderStrongBrush}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.6" />
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Message}" Style="{StaticResource MutedText}" FontSize="14" LineHeight="21" Margin="0,12,0,26" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource ModernButton}" Content="{Binding CancelText}" Command="{Binding CancelCommand}"
                                        Visibility="{Binding ShowCancel, Converter={StaticResource BoolToVisibility}}" Margin="0,0,10,0" />
                                <Button Style="{StaticResource GlowButton}" Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}"
                                        Padding="24,10" FontSize="13" IsDefault="True"
                                        Visibility="{Binding IsDanger, Converter={StaticResource InverseBoolToVisibility}}" />
                                <Button Style="{StaticResource DangerButton}" Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}"
                                        Visibility="{Binding IsDanger, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
