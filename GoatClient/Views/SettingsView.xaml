<UserControl x:Class="GoatClient.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:GoatClient.Controls"
             xmlns:vm="clr-namespace:GoatClient.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">
    <UserControl.Resources>
        <Style x:Key="SettingRow" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource InputBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="18,14" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel>
            <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock Text="{Binding SaveState}" FontSize="12" VerticalAlignment="Center" Margin="0,0,14,0" MaxWidth="380" TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Button Style="{StaticResource GlowButton}" Content="SAVE" Command="{Binding SaveSettingsCommand}" Padding="26,10" FontSize="13" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="SETTINGS" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Changes are saved automatically to %APPDATA%\GoatClient\settings.json." Style="{StaticResource PageSubtitle}" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1" Margin="0,22,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource ModernCard}" Padding="10" VerticalAlignment="Top">
                <StackPanel>
                    <controls:SidebarButton Content="GENERAL" Icon="{StaticResource IconSettings}" Command="{Binding SelectCategoryCommand}" CommandParameter="GENERAL"
                                            IsActive="{Binding SelectedCategory, Converter={StaticResource EqualsConverter}, ConverterParameter=GENERAL}" />
                    <controls:SidebarButton Content="MINECRAFT" Icon="{StaticResource IconCube}" Command="{Binding SelectCategoryCommand}" CommandParameter="MINECRAFT"
                                            IsActive="{Binding SelectedCategory, Converter={StaticResource EqualsConverter}, ConverterParameter=MINECRAFT}" />
                    <controls:SidebarButton Content="JAVA" Icon="{StaticResource IconJava}" Command="{Binding SelectCategoryCommand}" CommandParameter="JAVA"
                                            IsActive="{Binding SelectedCategory, Converter={StaticResource EqualsConverter}, ConverterParameter=JAVA}" />
                    <controls:SidebarButton Content="APPEARANCE" Icon="{StaticResource IconSkins}" Command="{Binding SelectCategoryCommand}" CommandParameter="APPEARANCE"
                                            IsActive="{Binding SelectedCategory, Converter={StaticResource EqualsConverter}, ConverterParameter=APPEARANCE}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource ModernCard}" Padding="26,24,14,24">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="0,0,12,0">
                        <!-- GENERAL -->
                        <StackPanel Visibility="{Binding SelectedCategory, Converter={StaticResource EqualsToVisibility}, ConverterParameter=GENERAL}">
                            <TextBlock Text="General" Style="{StaticResource CardTitle}" FontSize="18" Margin="0,0,0,16" />
                            <Border Style="{StaticResource SettingRow}">
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding LaunchWithWindows}">
                                    <StackPanel>
                                        <TextBlock Text="Launch launcher with Windows" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                                        <TextBlock Text="Adds GOAT CLIENT to your Windows sign-in startup (current user only)." Style="{StaticResource MutedText}" FontSize="12" />
                                    </StackPanel>
                                </CheckBox>
                            </Border>
                            <Border Style="{StaticResource SettingRow}">
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding NotificationsEnabled}">
                                    <StackPanel>
                                        <TextBlock Text="Notifications" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                                        <TextBlock Text="Show confirmation toasts inside the launcher. Errors are always shown." Style="{StaticResource MutedText}" FontSize="12" />
                                    </StackPanel>
                                </CheckBox>
                            </Border>
                            <Border Style="{StaticResource SettingRow}">
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ConfirmBeforeClosing}">
                                    <StackPanel>
                                        <TextBlock Text="Confirm before closing" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                                        <TextBlock Text="Ask before the launcher window closes." Style="{StaticResource MutedText}" FontSize="12" />
                                    </StackPanel>
                                </CheckBox>
                            </Border>
                        </StackPanel>

                        <!-- MINECRAFT -->
                        <StackPanel Visibility="{Binding SelectedCategory, Converter={StaticResource EqualsToVisibility}, ConverterParameter=MINECRAFT}">
                            <TextBlock Text="Minecraft" Style="{StaticResource CardTitle}" FontSize="18" Margin="0,0,0,4" />
                            <TextBlock Text="Defaults for new profiles and startup." Style="{StaticResource MutedText}" Margin="0,0,0,16" />

                            <TextBlock Text="Minecraft directory" Style="{StaticResource FieldLabel}" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Command="{Binding OpenDataFolderCommand}" ToolTip="Open folder" Margin="8,0,0,0" Height="40" Width="40">
                                    <Path Data="{StaticResource IconFolder}" Style="{StaticResource IconPath}" />
                                </Button>
                                <Button DockPanel.Dock="Right" Style="{StaticResource ModernButton}" Content="Browse…" Command="{Binding BrowseMinecraftDirectoryCommand}" Margin="8,0,0,0" />
                                <TextBox Text="{Binding MinecraftDirectory, UpdateSourceTrigger=LostFocus}" />
                            </DockPanel>

                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Default version" Style="{StaticResource FieldLabel}" />
                                    <ComboBox ItemsSource="{Binding Versions}" SelectedValuePath="Id" SelectedValue="{Binding DefaultVersion}" DisplayMemberPath="Id" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Default profile (on startup)" Style="{StaticResource FieldLabel}" />
                                    <ComboBox ItemsSource="{Binding ProfileChoices}" SelectedValuePath="Id" SelectedValue="{Binding DefaultProfileId}" DisplayMemberPath="Name" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Default RAM" Style="{StaticResource FieldLabel}" Margin="0,18,0,7" />
                            <ComboBox ItemsSource="{Binding RamOptions}" SelectedValuePath="Mb" SelectedValue="{Binding DefaultRamMb}"
                                      DisplayMemberPath="Label" ItemContainerStyle="{StaticResource RamComboItem}" />
                            <TextBlock Text="{Binding MemorySummary}" Style="{StaticResource MutedText}" FontSize="11" Margin="2,6,0,0" />

                            <TextBlock Text="Default JVM arguments" Style="{StaticResource FieldLabel}" Margin="0,18,0,7" />
                            <TextBox Text="{Binding DefaultJvmArguments, UpdateSourceTrigger=LostFocus}" FontFamily="Consolas" />
                            <TextBlock Text="Optional. Memory is set via RAM – do not use -Xmx / -Xms." Style="{StaticResource MutedText}" FontSize="11" Margin="2,6,0,0" />
                        </StackPanel>

                        <!-- JAVA -->
                        <StackPanel Visibility="{Binding SelectedCategory, Converter={StaticResource EqualsToVisibility}, ConverterParameter=JAVA}">
                            <TextBlock Text="Java runtime" Style="{StaticResource CardTitle}" FontSize="18" Margin="0,0,0,4" />
                            <TextBlock Text="Managed by GOAT CLIENT · Automatic. You never need to install Java yourself." Style="{StaticResource MutedText}" Margin="0,0,0,16" />

                            <Border Style="{StaticResource SettingRow}">
                                <StackPanel>
                                    <TextBlock Text="Runtime folder" Style="{StaticResource SectionLabel}" />
                                    <DockPanel Margin="0,6,0,0">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Command="{Binding OpenRuntimeFolderCommand}" ToolTip="Open folder">
                                            <Path Data="{StaticResource IconFolder}" Style="{StaticResource IconPath}" />
                                        </Button>
                                        <TextBlock Text="{Binding RuntimeDirectory}" Style="{StaticResource BodyText}" VerticalAlignment="Center" />
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SettingRow}">
                                <StackPanel>
                                    <TextBlock Text="Managed runtimes" Style="{StaticResource SectionLabel}" />
                                    <TextBlock Text="{Binding ManagedRuntimeText}" Style="{StaticResource BodyText}" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SettingRow}">
                                <StackPanel>
                                    <TextBlock Text="Automatic provisioning" Style="{StaticResource SectionLabel}" />
                                    <TextBlock Text="{Binding ProvisioningText}" Style="{StaticResource BodyText}" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SettingRow}">
                                <StackPanel>
                                    <TextBlock Text="System Java (optional information)" Style="{StaticResource SectionLabel}" />
                                    <TextBlock Text="{Binding SystemJavaText}" Style="{StaticResource BodyText}" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                            <Button Style="{StaticResource ModernButton}" Content="Check runtimes again" Command="{Binding RescanJavaCommand}" HorizontalAlignment="Left" Margin="0,6,0,0" />
                        </StackPanel>

                        <!-- APPEARANCE -->
                        <StackPanel Visibility="{Binding SelectedCategory, Converter={StaticResource EqualsToVisibility}, ConverterParameter=APPEARANCE}">
                            <TextBlock Text="Appearance" Style="{StaticResource CardTitle}" FontSize="18" Margin="0,0,0,16" />
                            <Border Style="{StaticResource SettingRow}">
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding EnablePageTransitions}">
                                    <StackPanel>
                                        <TextBlock Text="Page transitions" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                                        <TextBlock Text="Subtle fade when switching pages." Style="{StaticResource MutedText}" FontSize="12" />
                                    </StackPanel>
                                </CheckBox>
                            </Border>
                            <Border Style="{StaticResource SettingRow}">
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowHomeLogo}">
                                    <StackPanel>
                                        <TextBlock Text="Show logo on Home" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                                        <TextBlock Text="Displays the GOAT CLIENT logo in the Home hero section." Style="{StaticResource MutedText}" FontSize="12" />
                                    </StackPanel>
                                </CheckBox>
                            </Border>
                            <Border Style="{StaticResource SettingRow}">
                                <StackPanel>
                                    <TextBlock Text="Theme" Style="{StaticResource SectionLabel}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Border Width="28" Height="28" CornerRadius="8" Background="{StaticResource BackgroundBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" Margin="0,0,8,0" />
                                        <Border Width="28" Height="28" CornerRadius="8" Background="{StaticResource CardBrush}" Margin="0,0,8,0" />
                                        <Border Width="28" Height="28" CornerRadius="8" Background="{StaticResource SecondaryBrush}" Margin="0,0,8,0" />
                                        <Border Width="28" Height="28" CornerRadius="8" Background="{StaticResource AccentBrush}" Margin="0,0,8,0" />
                                        <Border Width="28" Height="28" CornerRadius="8" Background="{StaticResource Accent2Brush}" Margin="0,0,8,0" />
                                        <TextBlock Text="GOAT Dark (only theme in Phase 1)" Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="6,0,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
