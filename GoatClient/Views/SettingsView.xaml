<UserControl x:Class="GoatClient.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:GoatClient.Controls"
             xmlns:vm="clr-namespace:GoatClient.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">
    <UserControl.Resources>
        <Style x:Key="SettingRow" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource InputBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="18,14" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel>
            <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock Text="{Binding SaveState}" FontSize="12" VerticalAlignment="Center" Margin="0,0,14,0" MaxWidth="380" TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasError}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <Button Style="{StaticResource GlowButton}" Content="SAVE" Command="{Binding SaveSettingsCommand}" Padding="26,10" FontSize="13" />
            </StackPanel>
            <StackPanel>
                <TextBlock Text="SETTINGS" Style="{StaticResource PageTitle}" />
                <TextBlock Text="Changes are saved automatically to %APPDATA%\GoatClient\config\settings.json." Style="{StaticResource PageSubtitle}" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1" Margin="0,22,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource ModernCard}" Padding="10" VerticalAlignment="Top">
                <StackPanel>
                    <controls:SidebarButton Content="LAUNCHER" Icon="{StaticResource IconSettings}" Command="{Binding SelectCategoryCommand}" CommandParameter="LAUNCHER"
                                            IsActive="{Binding SelectedCategory, Converter={StaticResource EqualsConverter}, ConverterParameter=LAUNCHER}" />
                    <controls:SidebarButton Content="MINECRAFT" Icon="{StaticResource IconCube}" Command="{Binding SelectCategoryCommand}" CommandParameter="MINECRAFT"
                                            IsActive="{Binding SelectedCategory, Converter={StaticResource EqualsConverter}, ConverterParameter=MINECRAFT}" />
                    <controls:SidebarButton Content="APPEARANCE" Icon="{StaticResource IconSkins}" Command="{Binding SelectCategoryCommand}" CommandParameter="APPEARANCE"
                                            IsActive="{Binding SelectedCategory, Converter={StaticResource EqualsConverter}, ConverterParameter=APPEARANCE}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource ModernCard}" Padding="26,24,14,24">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="0,0,12,0">
                        <!-- LAUNCHER -->
                        <StackPanel Visibility="{Binding SelectedCategory, Converter={StaticResource EqualsToVisibility}, ConverterParameter=LAUNCHER}">
                            <TextBlock Text="Launcher" Style="{StaticResource CardTitle}" FontSize="18" Margin="0,0,0,16" />

                            <Border Style="{StaticResource SettingRow}">
                                <StackPanel>
                                    <TextBlock Text="How PLAY starts Minecraft" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                                    <ComboBox x:Name="LaunchModeBox" ItemsSource="{Binding LaunchModes}" SelectedValuePath="Value" SelectedValue="{Binding LaunchMode}" DisplayMemberPath="Label" Margin="0,10,0,8" />
                                    <TextBlock Style="{StaticResource MutedText}" FontSize="12"
                                               Text="{Binding SelectedItem.Description, ElementName=LaunchModeBox}" />
                                    <DockPanel Margin="0,10,0,0">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Command="{Binding OpenOfficialFolderCommand}" ToolTip="Open .minecraft folder">
                                            <Path Data="{StaticResource IconFolder}" Style="{StaticResource IconPath}" />
                                        </Button>
                                        <TextBlock Text="{Binding OfficialLauncherStatus}" Style="{StaticResource MutedText}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource SettingRow}">
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding LaunchWithWindows}">
                                    <StackPanel>
                                        <TextBlock Text="Launch launcher with Windows" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                                        <TextBlock Text="Adds GOAT CLIENT to your Windows sign-in startup (current user only)." Style="{StaticResource MutedText}" FontSize="12" />
                                    </StackPanel>
                                </CheckBox>
                            </Border>
                            <Border Style="{StaticResource SettingRow}">
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding NotificationsEnabled}">
                                    <StackPanel>
                                        <TextBlock Text="Notifications" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                                        <TextBlock Text="Show confirmation toasts inside the launcher. Errors are always shown." Style="{StaticResource MutedText}" FontSize="12" />
                                    </StackPanel>
                                </CheckBox>
                            </Border>
                            <Border Style="{StaticResource SettingRow}">
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ConfirmBeforeClosing}">
                                    <StackPanel>
                                        <TextBlock Text="Confirm before closing" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                                        <TextBlock Text="Ask before the launcher window closes." Style="{StaticResource MutedText}" FontSize="12" />
                                    </StackPanel>
                                </CheckBox>
                            </Border>
                            <Border Style="{StaticResource SettingRow}" Visibility="{Binding IsDirectMode, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="Microsoft app (client) ID" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource MutedText}" FontSize="12" Margin="0,2,0,2">
                                        <Run Text="Active source:" /> <Run Text="{Binding ClientIdSource, Mode=OneWay}" Foreground="{StaticResource AccentBrush}" />
                                    </TextBlock>
                                    <TextBlock Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,10" TextWrapping="Wrap"
                                               Text="Normally the ID comes from microsoft-auth.json next to GoatClient.exe. Only enter a value here to override it for testing." />
                                    <TextBox Text="{Binding MicrosoftClientId, UpdateSourceTrigger=LostFocus}" FontFamily="Consolas" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- MINECRAFT -->
                        <StackPanel Visibility="{Binding SelectedCategory, Converter={StaticResource EqualsToVisibility}, ConverterParameter=MINECRAFT}">
                            <TextBlock Text="Minecraft" Style="{StaticResource CardTitle}" FontSize="18" Margin="0,0,0,4" />
                            <TextBlock Text="Defaults for new profiles and startup." Style="{StaticResource MutedText}" Margin="0,0,0,16" />

                            <TextBlock Text="Game directory root (one folder per profile)" Style="{StaticResource FieldLabel}" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Command="{Binding OpenDataFolderCommand}" ToolTip="Open folder" Margin="8,0,0,0" Height="40" Width="40">
                                    <Path Data="{StaticResource IconFolder}" Style="{StaticResource IconPath}" />
                                </Button>
                                <Button DockPanel.Dock="Right" Style="{StaticResource ModernButton}" Content="Browse…" Command="{Binding BrowseMinecraftDirectoryCommand}" Margin="8,0,0,0" />
                                <TextBox Text="{Binding MinecraftDirectory, UpdateSourceTrigger=LostFocus}" />
                            </DockPanel>

                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Default version" Style="{StaticResource FieldLabel}" />
                                    <ComboBox ItemsSource="{Binding Versions}" SelectedValuePath="Id" SelectedValue="{Binding DefaultVersion}" DisplayMemberPath="Id" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Default profile (on startup)" Style="{StaticResource FieldLabel}" />
                                    <ComboBox ItemsSource="{Binding ProfileChoices}" SelectedValuePath="Id" SelectedValue="{Binding DefaultProfileId}" DisplayMemberPath="Name" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Default RAM" Style="{StaticResource FieldLabel}" Margin="0,18,0,7" />
                            <ComboBox ItemsSource="{Binding RamOptions}" SelectedValuePath="Mb" SelectedValue="{Binding DefaultRamMb}"
                                      DisplayMemberPath="Label" ItemContainerStyle="{StaticResource RamComboItem}" />
                            <TextBlock Text="{Binding MemorySummary}" Style="{StaticResource MutedText}" FontSize="11" Margin="2,6,0,0" />

                            <TextBlock Text="Default JVM arguments" Style="{StaticResource FieldLabel}" Margin="0,18,0,7" />
                            <TextBox Text="{Binding DefaultJvmArguments, UpdateSourceTrigger=LostFocus}" FontFamily="Consolas" />
                            <TextBlock Text="Optional. Memory is set via RAM – do not use -Xmx / -Xms." Style="{StaticResource MutedText}" FontSize="11" Margin="2,6,0,0" />

                            <Border Style="{StaticResource SettingRow}" Margin="0,18,0,0">
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ShowSnapshots}">
                                    <StackPanel>
                                        <TextBlock Text="Show snapshots" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                                        <TextBlock Text="List official snapshot versions in addition to releases." Style="{StaticResource MutedText}" FontSize="12" />
                                    </StackPanel>
                                </CheckBox>
                            </Border>
                        </StackPanel>

                        <!-- APPEARANCE -->
                        <StackPanel Visibility="{Binding SelectedCategory, Converter={StaticResource EqualsToVisibility}, ConverterParameter=APPEARANCE}">
                            <TextBlock Text="Appearance" Style="{StaticResource CardTitle}" FontSize="18" Margin="0,0,0,16" />
                            <Border Style="{StaticResource SettingRow}">
                                <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding EnablePageTransitions}">
                                    <StackPanel>
                                        <TextBlock Text="Animations" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                                        <TextBlock Text="Subtle fade when switching pages." Style="{StaticResource MutedText}" FontSize="12" />
                                    </StackPanel>
                                </CheckBox>
                            </Border>
                            <Border Style="{StaticResource SettingRow}">
                                <StackPanel>
                                    <TextBlock Text="Theme" Style="{StaticResource SectionLabel}" />
                                    <ListBox ItemsSource="{Binding ThemeOptions}" SelectedValuePath="Id" SelectedValue="{Binding Theme}"
                                             Background="Transparent" BorderThickness="0" Margin="0,10,0,0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Cursor" Value="Hand" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border x:Name="Frame" CornerRadius="10" BorderThickness="2" BorderBrush="Transparent" Padding="8" Margin="0,0,10,10" Background="{StaticResource InputBrush}">
                                                                <ContentPresenter />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                                </Trigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Frame" Property="Background" Value="{StaticResource SecondaryBrush}" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Width="120">
                                                    <Border Height="44" CornerRadius="6" Background="{Binding Background}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                                                            <Border Width="30" Height="22" CornerRadius="4" Background="{Binding Card}" Margin="0,0,6,0" />
                                                            <Border Width="30" Height="22" CornerRadius="4" Background="{Binding Secondary}" />
                                                        </StackPanel>
                                                    </Border>
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource BodyText}" FontSize="12" Margin="2,6,0,0" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <TextBlock Text="Accent color" Style="{StaticResource SectionLabel}" Margin="0,8,0,0" />
                                    <ListBox ItemsSource="{Binding AccentOptions}" SelectedValuePath="Id" SelectedValue="{Binding Accent}"
                                             Background="Transparent" BorderThickness="0" Margin="0,10,0,0"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Cursor" Value="Hand" />
                                                <Setter Property="ToolTip" Value="{Binding Name}" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <Border x:Name="Frame" CornerRadius="10" BorderThickness="2" BorderBrush="Transparent" Padding="6" Margin="0,0,10,10" Background="{StaticResource InputBrush}">
                                                                <ContentPresenter />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsSelected" Value="True">
                                                                    <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource TextBrush}" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="22" Height="22" CornerRadius="11" Background="{Binding Accent}" />
                                                    <Border Width="22" Height="22" CornerRadius="11" Background="{Binding Accent2}" Margin="-6,0,0,0" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>

                                    <Border CornerRadius="10" Background="{StaticResource AccentSoftBrush}" Padding="14,10" Margin="0,4,0,0"
                                            Visibility="{Binding RestartRequired, Converter={StaticResource BoolToVisibility}}">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource GlowButton}" Content="Restart now" Command="{Binding RestartCommand}" Padding="16,7" FontSize="12" />
                                            <TextBlock Text="The new theme is applied after a restart of GOAT CLIENT." Style="{StaticResource BodyText}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
                                        </DockPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
