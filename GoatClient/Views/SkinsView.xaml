<UserControl x:Class="GoatClient.Views.SkinsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:GoatClient.Controls"
             xmlns:vm="clr-namespace:GoatClient.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SkinsViewModel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="SKINS" Style="{StaticResource PageTitle}" />
            <TextBlock Text="The skin of your signed-in Minecraft account." Style="{StaticResource PageSubtitle}" />
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource ModernCard}" Margin="0,22,0,0" Padding="40">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="640">
                <!-- Real skin -->
                <StackPanel Visibility="{Binding HasSkin, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Border Width="120" Height="120" CornerRadius="18" Background="{StaticResource SecondaryBrush}" ClipToBounds="True">
                            <Grid>
                                <Image Source="{Binding Face}" RenderOptions.BitmapScalingMode="NearestNeighbor" Stretch="Fill" />
                                <Image Source="{Binding Hat}" RenderOptions.BitmapScalingMode="NearestNeighbor" Stretch="Fill" />
                            </Grid>
                        </Border>
                        <Border Width="256" Height="256" CornerRadius="12" Background="{StaticResource InputBrush}" Margin="28,0,0,0" Padding="8">
                            <Image Source="{Binding SkinTexture}" RenderOptions.BitmapScalingMode="NearestNeighbor" Stretch="Uniform" ToolTip="Skin texture" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding Username}" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,22,0,0" />
                    <TextBlock HorizontalAlignment="Center" Style="{StaticResource MutedText}"><Run Text="Model:" /> <Run Text="{Binding SkinModel, Mode=OneWay}" /></TextBlock>
                </StackPanel>

                <!-- Not signed in / no skin -->
                <StackPanel Visibility="{Binding HasSkin, Converter={StaticResource InverseBoolToVisibility}}">
                    <Border Width="84" Height="84" CornerRadius="24" Background="{StaticResource AccentSoftBrush}" HorizontalAlignment="Center">
                        <Path Data="{StaticResource IconSkins}" Fill="{StaticResource AccentBrush}" Width="38" Height="38" Stretch="Uniform" />
                    </Border>
                    <TextBlock Text="No skin to show" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,22,0,0" />
                    <TextBlock Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,10,0,18" FontSize="14"
                               Text="Sign in with your Microsoft account to see your current Minecraft skin." />
                    <Button Style="{StaticResource ModernButton}" Content="Go to Account" Command="{Binding OpenAccountCommand}" HorizontalAlignment="Center" />
                </StackPanel>

            </Grid>
        </Border>
    </Grid>
</UserControl>
