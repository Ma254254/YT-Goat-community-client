<UserControl x:Class="GoatClient.Views.SkinsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:GoatClient.Controls"
             xmlns:vm="clr-namespace:GoatClient.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SkinsViewModel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="SKINS" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Customize how you look in Minecraft." Style="{StaticResource PageSubtitle}" />
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource ModernCard}" Margin="0,22,0,0" Padding="48">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560">
                <StackPanel>
                    <Border Width="84" Height="84" CornerRadius="24" Background="{StaticResource AccentSoftBrush}" HorizontalAlignment="Center">
                        <Path Data="{StaticResource IconSkins}" Fill="{StaticResource AccentBrush}" Width="38" Height="38" Stretch="Uniform" />
                    </Border>
                    <TextBlock Text="{Binding Title}" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,22,0,0" />
                    <Border Style="{StaticResource Badge}" HorizontalAlignment="Center" Margin="0,10,0,0" Padding="12,5">
                        <TextBlock Text="{Binding Phase}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                    </Border>
                    <TextBlock Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,18,0,20" FontSize="14"
                               Text="Skins are linked to your Microsoft account. As soon as sign-in is available, you will manage them here. No skin data is shown before that." />
                    <ItemsControl ItemsSource="{Binding PlannedFeatures}" Focusable="False" HorizontalAlignment="Center">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,5">
                                    <Path Data="{StaticResource IconCheck}" Fill="{StaticResource MutedBrush}" Width="14" Height="14" Stretch="Uniform" />
                                    <TextBlock Text="{Binding}" Style="{StaticResource BodyText}" Margin="10,0,0,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
