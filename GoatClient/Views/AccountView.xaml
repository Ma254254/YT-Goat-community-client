<UserControl x:Class="GoatClient.Views.AccountView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:GoatClient.Controls"
             xmlns:vm="clr-namespace:GoatClient.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AccountViewModel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="ACCOUNT" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Your Minecraft account – signed in securely with Microsoft." Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource ModernCard}" Margin="0,22,0,0" Padding="40,30">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560">

                <!-- SIGNED IN -->
                <StackPanel Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="MINECRAFT ACCOUNT" Style="{StaticResource SectionLabel}" HorizontalAlignment="Center" />
                    <Border Width="112" Height="112" CornerRadius="18" Background="{StaticResource SecondaryBrush}" HorizontalAlignment="Center" Margin="0,16,0,0" ClipToBounds="True">
                        <Grid>
                            <Image Source="{Binding Face}" RenderOptions.BitmapScalingMode="NearestNeighbor" Stretch="Fill" />
                            <Image Source="{Binding Hat}" RenderOptions.BitmapScalingMode="NearestNeighbor" Stretch="Fill" />
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding Username}" FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,18,0,0" />
                    <TextBlock Text="{Binding StatusText}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center" Margin="0,4,0,0" />

                    <Border Style="{StaticResource ModernCard}" Background="{StaticResource InputBrush}" Padding="18,14" Margin="0,22,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Username" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Column="1" Text="{Binding Username}" Style="{StaticResource BodyText}" />
                            <TextBlock Grid.Row="1" Text="UUID" Style="{StaticResource FieldLabel}" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Uuid, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent" Padding="0" FontFamily="Consolas" Margin="0,0,0,7" />
                            <TextBlock Grid.Row="2" Text="Skin model" Style="{StaticResource FieldLabel}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SkinModel}" Style="{StaticResource BodyText}" />
                        </Grid>
                    </Border>

                    <Button Style="{StaticResource DangerButton}" Command="{Binding LogoutCommand}" HorizontalAlignment="Center" Margin="0,22,0,0" Padding="26,11">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconLogout}" Fill="{StaticResource DangerBrush}" Width="13" Height="13" Stretch="Uniform" Margin="0,0,8,0" />
                            <TextBlock Text="LOGOUT" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- SIGNED OUT / EXPIRED -->
                <StackPanel Visibility="{Binding IsSignedOut, Converter={StaticResource BoolToVisibility}}">
                    <!-- Minecraft name: public profile for name + skin display (no login) -->
                    <Border Style="{StaticResource ModernCard}" Background="{StaticResource InputBrush}" Padding="20" Margin="0,0,0,28">
                        <StackPanel>
                            <TextBlock Text="MINECRAFT NAME" Style="{StaticResource SectionLabel}" />
                            <TextBlock Style="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,14"
                                       Text="You sign in inside the official Minecraft Launcher. Link your Minecraft name here so GOAT CLIENT can show your name and skin – it only uses public profile data, no login and no password." />

                            <!-- linked -->
                            <DockPanel Visibility="{Binding IsLinked, Converter={StaticResource BoolToVisibility}}">
                                <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}" Content="Unlink" Command="{Binding UnlinkCommand}" VerticalAlignment="Center" />
                                <Border Width="48" Height="48" CornerRadius="10" Background="{StaticResource SecondaryBrush}" ClipToBounds="True">
                                    <Grid>
                                        <Image Source="{Binding LinkedFace}" RenderOptions.BitmapScalingMode="NearestNeighbor" Stretch="Fill" />
                                        <Image Source="{Binding LinkedHat}" RenderOptions.BitmapScalingMode="NearestNeighbor" Stretch="Fill" />
                                    </Grid>
                                </Border>
                                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding LinkedUsername}" FontSize="18" FontWeight="Bold" />
                                    <TextBlock Text="{Binding LinkedUuid}" Style="{StaticResource MutedText}" FontSize="11" FontFamily="Consolas" />
                                </StackPanel>
                            </DockPanel>

                            <!-- not linked -->
                            <DockPanel Visibility="{Binding IsLinked, Converter={StaticResource InverseBoolToVisibility}}">
                                <Button DockPanel.Dock="Right" Style="{StaticResource GlowButton}" Content="Link" Command="{Binding LinkCommand}" Margin="8,0,0,0" Padding="20,9" />
                                <TextBox Text="{Binding LinkName, UpdateSourceTrigger=PropertyChanged}" MaxLength="16" />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="DIRECT SIGN-IN (OPTIONAL)" Style="{StaticResource SectionLabel}" HorizontalAlignment="Center" Margin="0,0,0,14" />
                    <Border Width="84" Height="84" CornerRadius="42" Background="{StaticResource SecondaryBrush}" HorizontalAlignment="Center">
                        <Path Data="{StaticResource IconAccount}" Fill="{StaticResource MutedBrush}" Width="36" Height="36" Stretch="Uniform" />
                    </Border>
                    <TextBlock Text="{Binding StatusText}" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,22,0,0" />
                    <TextBlock Text="Microsoft Account" Style="{StaticResource BodyText}" FontSize="15" HorizontalAlignment="Center" Margin="0,6,0,0" />
                    <TextBlock Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,16,0,22" FontSize="13"
                               Text="Only needed for direct launch and skin uploads. You sign in on Microsoft's own website; GOAT CLIENT never sees your password. Only a refresh token is stored – encrypted in the Windows Credential Manager." />

                    <!-- Device code panel -->
                    <Border Style="{StaticResource ModernCard}" Background="{StaticResource InputBrush}" Padding="20" Margin="0,0,0,20"
                            Visibility="{Binding IsSigningIn, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock Text="{Binding SignInStatus}" Style="{StaticResource MutedText}" TextAlignment="Center" />
                            <TextBlock Text="{Binding UserCode}" FontFamily="Consolas" FontSize="32" FontWeight="Bold" Foreground="{StaticResource AccentBrush}"
                                       HorizontalAlignment="Center" Margin="0,12,0,4" />
                            <TextBlock Text="{Binding VerificationUri}" Style="{StaticResource MutedText}" FontSize="12" HorizontalAlignment="Center" />
                            <ProgressBar IsIndeterminate="{Binding IsSigningIn}" Margin="40,16,40,14" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Style="{StaticResource ModernButton}" Content="Copy code" Command="{Binding CopyCodeCommand}" Margin="0,0,8,0" />
                                <Button Style="{StaticResource ModernButton}" Command="{Binding OpenVerificationPageCommand}" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Open Microsoft page" />
                                        <Path Data="{StaticResource IconExternal}" Style="{StaticResource IconPath}" Width="10" Height="10" Margin="8,0,0,0" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource GhostButton}" Content="Cancel" Command="{Binding CancelLoginCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Button Style="{StaticResource GlowButton}" Command="{Binding LoginCommand}" HorizontalAlignment="Center" Padding="30,13" FontSize="14"
                            Visibility="{Binding IsSigningIn, Converter={StaticResource InverseBoolToVisibility}}">
                        <TextBlock Text="LOGIN WITH MICROSOFT" />
                    </Button>

                    <TextBlock Style="{StaticResource MutedText}" FontSize="12" TextAlignment="Center" Margin="0,16,0,0"
                               Visibility="{Binding IsConfigured, Converter={StaticResource InverseBoolToVisibility}}">
                        <Run Text="Direct sign-in is not configured yet (microsoft-auth.json)." />
                        <Hyperlink Command="{Binding OpenSettingsCommand}" Foreground="{StaticResource AccentBrush}">Open Settings</Hyperlink>
                    </TextBlock>
                </StackPanel>
            </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
