<UserControl x:Class="GoatClient.Views.PlayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:GoatClient.Controls"
             xmlns:vm="clr-namespace:GoatClient.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PlayViewModel}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="PLAY" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Choose profile, Minecraft version, memory and Java. Changes are saved to the selected profile automatically." Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,22,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="390" />
            </Grid.ColumnDefinitions>

            <!-- Left: configuration -->
            <Border Style="{StaticResource ModernCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Profile" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name" />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Java Runtime" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding JavaPreferences}" SelectedValuePath="Value" SelectedValue="{Binding SelectedJava}" DisplayMemberPath="Label" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="RAM" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding RamOptions}" SelectedValuePath="Mb" SelectedValue="{Binding SelectedRamMb}"
                                      DisplayMemberPath="Label" ItemContainerStyle="{StaticResource RamComboItem}" />
                            <TextBlock Text="{Binding MemorySummary}" Style="{StaticResource MutedText}" FontSize="11" Margin="2,6,0,0" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,22,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="260" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Bottom">
                            <TextBlock Text="Minecraft version" Style="{StaticResource FieldLabel}" />
                            <TextBlock Text="{Binding VersionSourceText}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,-4,0,0" />
                        </StackPanel>
                        <Grid Grid.Column="1">
                            <TextBox Text="{Binding VersionFilter, UpdateSourceTrigger=PropertyChanged}" Padding="36,9,12,9" ToolTip="Filter versions" />
                            <Path Data="{StaticResource IconSearch}" Fill="{StaticResource MutedBrush}" Width="14" Height="14" Stretch="Uniform"
                                  HorizontalAlignment="Left" Margin="13,0,0,0" IsHitTestVisible="False" />
                        </Grid>
                    </Grid>

                    <ListBox Grid.Row="2" ItemsSource="{Binding FilteredVersions}" SelectedItem="{Binding SelectedVersion}"
                             Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             FocusVisualStyle="{x:Null}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" CornerRadius="12" Margin="0,0,0,8" Padding="16,12" Background="{StaticResource InputBrush}"
                                                    BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource SecondaryBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Path Data="{StaticResource IconCube}" Fill="{StaticResource MutedBrush}" Width="16" Height="16" Stretch="Uniform" />
                                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextBrush}" />
                                        <TextBlock Style="{StaticResource MutedText}" FontSize="11"><Run Text="{Binding TypeText, Mode=OneWay}" /> · <Run Text="{Binding ReleaseDateText, Mode=OneWay}" /> · <Run Text="{Binding JavaText, Mode=OneWay}" /></TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Style="{StaticResource Badge}" Background="{StaticResource AccentSoftBrush}" Margin="0,0,6,0"
                                                Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Text="● Installed" FontSize="11" Foreground="{StaticResource AccentBrush}" />
                                        </Border>
                                        <Border Style="{StaticResource Badge}" Background="{StaticResource SecondaryBrush}"
                                                Visibility="{Binding IsInstalled, Converter={StaticResource InverseBoolToVisibility}}">
                                            <TextBlock Text="○ Not Installed" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Right: summary, actions, launch log -->
            <Border Grid.Column="2" Style="{StaticResource ModernCard}" Padding="22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="90" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Style="{StaticResource Badge}">
                                <TextBlock Text="{Binding Game.InstallStateText}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                            </Border>
                            <TextBlock Text="{Binding SelectedVersion.DisplayName, FallbackValue=Minecraft}" Style="{StaticResource ValueText}" />
                        </DockPanel>
                        <TextBlock Text="{Binding VersionSummary}" Style="{StaticResource MutedText}" FontSize="11" />

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Profile" Style="{StaticResource FieldLabel}" Margin="0,0,0,2" />
                                <TextBlock Text="{Binding SelectedProfile.Name, FallbackValue=–}" Style="{StaticResource BodyText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="RAM" Style="{StaticResource FieldLabel}" Margin="0,0,0,2" />
                                <TextBlock Text="{Binding RamText}" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Game directory" Style="{StaticResource FieldLabel}" Margin="0,12,0,4" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Command="{Binding OpenGameDirectoryCommand}" ToolTip="Open folder" Margin="8,0,0,0">
                                <Path Data="{StaticResource IconFolder}" Style="{StaticResource IconPath}" />
                            </Button>
                            <TextBlock Text="{Binding GameDirectory}" Style="{StaticResource BodyText}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding GameDirectory}" />
                        </DockPanel>

                        <TextBlock Text="Java runtime" Style="{StaticResource FieldLabel}" Margin="0,12,0,2" />
                        <TextBlock Text="{Binding JavaTitle}" Style="{StaticResource BodyText}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding JavaDetail}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,16,0,12">
                        <controls:TransferPanel DataContext="{Binding Game}" Margin="0,0,0,12" />
                        <Button Style="{StaticResource GlowButton}" Command="{Binding Game.PrimaryCommand}" HorizontalAlignment="Stretch" Padding="0,14">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource IconPlay}" Fill="White" Width="13" Height="13" Stretch="Uniform" Margin="0,0,10,0" />
                                <TextBlock Text="{Binding Game.PrimaryText}" />
                            </StackPanel>
                        </Button>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource ModernButton}" Command="{Binding Game.RepairCommand}" Padding="0,9">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconWrench}" Style="{StaticResource IconPath}" Width="13" Height="13" Margin="0,0,8,0" />
                                    <TextBlock Text="REPAIR" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2" Style="{StaticResource ModernButton}" Command="{Binding Game.OpenLaunchLogCommand}" Padding="0,9" Content="VIEW LOG" />
                        </Grid>
                        <TextBlock Style="{StaticResource MutedText}" FontSize="11" Margin="0,8,0,0" HorizontalAlignment="Center">
                            <Run Text="Minecraft:" /> <Run Text="{Binding Game.ProcessStateText, Mode=OneWay}" FontWeight="SemiBold" />
                        </TextBlock>
                    </StackPanel>

                    <Border Grid.Row="2" CornerRadius="10" Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="LAUNCH LOG" Style="{StaticResource SectionLabel}" FontSize="10" Margin="12,8,0,4" />
                            <ListBox ItemsSource="{Binding Game.LaunchLog}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource MutedBrush}"
                                     FontFamily="Consolas" FontSize="10.5" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     VirtualizingPanel.IsVirtualizing="True" Margin="6,0,2,6">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <ContentPresenter Margin="4,1" />
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
