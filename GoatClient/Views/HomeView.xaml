<UserControl x:Class="GoatClient.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:GoatClient.Controls"
             xmlns:vm="clr-namespace:GoatClient.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:HomeViewModel}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,4,0">
            <!-- HERO -->
            <Border Style="{StaticResource ModernCard}" Padding="0" MinHeight="300">
                <Grid>
                    <Border CornerRadius="16" Background="{StaticResource HeroGlowBrush}" />
                    <Grid Margin="40,36">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Greeting}" FontSize="15" Foreground="{StaticResource MutedBrush}" />
                            <TextBlock Text="{Binding ProductName}" FontSize="52" FontWeight="Black" Margin="0,2,0,0" />
                            <TextBlock Text="{Binding Tagline}" FontSize="15" Foreground="{StaticResource AccentBrush}" Margin="0,2,0,22" />
                            <WrapPanel Margin="0,0,0,26">
                                <Border Style="{StaticResource Badge}" Background="{StaticResource SecondaryBrush}" Margin="0,0,8,6">
                                    <TextBlock FontSize="12"><Run Text="Minecraft" Foreground="{StaticResource MutedBrush}" /> <Run Text="{Binding VersionText, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
                                </Border>
                                <Border Style="{StaticResource Badge}" Background="{StaticResource SecondaryBrush}" Margin="0,0,8,6">
                                    <TextBlock FontSize="12"><Run Text="Profile" Foreground="{StaticResource MutedBrush}" /> <Run Text="{Binding ProfileName, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
                                </Border>
                                <Border Style="{StaticResource Badge}" Background="{StaticResource SecondaryBrush}" Margin="0,0,8,6">
                                    <TextBlock FontSize="12"><Run Text="RAM" Foreground="{StaticResource MutedBrush}" /> <Run Text="{Binding RamText, Mode=OneWay}" FontWeight="SemiBold" /></TextBlock>
                                </Border>
                            </WrapPanel>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource GlowButton}" Command="{Binding PlayCommand}" MinWidth="200" Padding="40,15">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IconPlay}" Fill="White" Width="14" Height="14" Stretch="Uniform" Margin="0,0,10,0" />
                                        <TextBlock Text="PLAY" FontSize="16" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource ModernButton}" Content="Configure" Command="{Binding OpenPlayCommand}" Margin="12,0,0,0" Padding="22,13" />
                            </StackPanel>
                        </StackPanel>
                        <Image Grid.Column="1" Source="{StaticResource LogoImage}" Height="230" Margin="30,0,10,0"
                               RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center"
                               Visibility="{Binding ShowLogo, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </Grid>
            </Border>

            <!-- STAT CARDS -->
            <UniformGrid Columns="4" Margin="-8,16,-8,0">
                <controls:StatCard Margin="8,0" Title="VERSION" Value="{Binding VersionText}" Caption="{Binding VersionState}" Icon="{StaticResource IconCube}" />
                <controls:StatCard Margin="8,0" Title="PROFILE" Value="{Binding ProfileName}" Caption="Active profile" Icon="{StaticResource IconProfiles}" />
                <controls:StatCard Margin="8,0" Title="RAM" Value="{Binding RamText}" Caption="Allocated memory" Icon="{StaticResource IconMemory}" />
                <controls:StatCard Margin="8,0" Title="STATUS" Value="{Binding Status.Status}" Caption="{Binding Status.Message}" Icon="{StaticResource IconPulse}" />
            </UniformGrid>

            <!-- INFO -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource ModernCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconJava}" Fill="{StaticResource AccentBrush}" Width="18" Height="18" Stretch="Uniform" />
                            <TextBlock Text="JAVA RUNTIME" Style="{StaticResource SectionLabel}" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding JavaTitle}" Style="{StaticResource CardTitle}" Margin="0,12,0,0" />
                        <TextBlock Text="{Binding JavaDetail}" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource ModernCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconInfo}" Fill="{StaticResource Accent2Brush}" Width="18" Height="18" Stretch="Uniform" />
                            <TextBlock Text="DEVELOPMENT PHASE" Style="{StaticResource SectionLabel}" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="Phase 1 – Launcher foundation" Style="{StaticResource CardTitle}" Margin="0,12,0,0" />
                        <TextBlock Style="{StaticResource MutedText}" Margin="0,6,0,12"
                                   Text="Profiles, versions, memory and settings work and are saved locally. Sign-in, installation and launching Minecraft follow in the next phases." />
                        <Button Style="{StaticResource ModernButton}" Content="Manage profiles" Command="{Binding OpenProfilesCommand}" HorizontalAlignment="Left" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
