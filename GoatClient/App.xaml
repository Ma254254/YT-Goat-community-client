<Application x:Class="GoatClient.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:GoatClient.Core.Converters"
             xmlns:vm="clr-namespace:GoatClient.ViewModels"
             xmlns:views="clr-namespace:GoatClient.Views"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Colors.xaml" />
                <ResourceDictionary Source="Themes/Icons.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Official GOAT CLIENT logo (original artwork, unchanged) -->
            <BitmapImage x:Key="LogoImage" UriSource="pack://application:,,,/GoatClient;component/Assets/Logo/GoatClientLogo.png" />

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
            <converters:NullToVisibilityConverter x:Key="NullToVisibility" />
            <converters:EqualsConverter x:Key="EqualsConverter" />
            <converters:EqualsToVisibilityConverter x:Key="EqualsToVisibility" />

            <!-- ViewModel → View mapping for the navigation host -->
            <DataTemplate DataType="{x:Type vm:HomeViewModel}"><views:HomeView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:PlayViewModel}"><views:PlayView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:ProfilesViewModel}"><views:ProfilesView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:SkinsViewModel}"><views:SkinsView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView /></DataTemplate>
            <DataTemplate DataType="{x:Type vm:AccountViewModel}"><views:AccountView /></DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
